# Optional: leave unset to use the working local template engine and session BYOK.
# Server keys are used ONLY by authenticated Supabase users with a database quota.
GEMINI_API_KEY=
# Choose a model enabled for your own AI Studio project. Availability varies.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: enables email/password accounts, cloud saves and server-key quotas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
