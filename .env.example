# Optional: leave unset to use the working local template engine and session BYOK.
# Server keys are used ONLY by authenticated Supabase users with a database quota.
GEMINI_API_KEY=
# Choose a model enabled for your own AI Studio project. Availability varies.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: enables email/password accounts, cloud saves and server-key quotas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shopify embedded app: leave unset while deploying the standalone demo.
# Register in Shopify Dev Dashboard later; managed installation uses token exchange.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Stable HTTPS ORIGIN only, e.g. https://your-project.vercel.app (no /shopify).
SHOPIFY_APP_URL=
SHOPIFY_API_VERSION=2026-10
# Server-only persistent store storage. Apply 001_initial.sql then 002_shopify.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public support contact; required before public merchant onboarding.
STUDIOSHELF_SUPPORT_EMAIL=
# Hosted AI is opt-in; attempts include failures. No automatic overage charges.
SHOPIFY_HOSTED_AI_ENABLED=false
SHOPIFY_AI_MONTHLY_LIMIT=20
SHOPIFY_AI_GLOBAL_MONTHLY_LIMIT=200
